Algoritmo ejercicio6
	definir num Como Entero;
	Escribir 'Ingresar el número deseado';
	leer num;
	si num>0 Entonces
		Escribir 'El número ingresado es ',num,', su cuadrado es ',num^2,' y su raíz cuadrada es ',raiz(num);
	SiNo
		Escribir 'Error insalvable El programa se cerrará';
		Esperar Tecla;
	FinSi
	
	
FinAlgoritmo
