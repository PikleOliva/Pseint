Algoritmo gradosFarenheit
	definir temp1, temp2 Como Real;
	escribir Sin Saltar'ingresar la temperatura en grados Celsius ';
	leer temp1;
	temp2=(temp1*9/5)+32;
	Escribir temp1,'ºC equivalen a ',temp2,'ºF',;
	escribir Sin Saltar 'ingresar la temperatura en grados Frarenheit ';
	leer temp1;
	temp2=(temp1-32)*5/9;
	Escribir temp1,'ºF equivalen a ',temp2,'ºC',;
	
FinAlgoritmo
