Algoritmo salarioSemanal
	definir salario, horas como entero
	escribir Sin Saltar'Establecer el valor hora trabajada ';
	leer salario
	Escribir Sin Saltar'Ingrese el número de horas trabajadas '
	Leer horas
	Escribir 'Usted trabajó ',horas,' esta semana, por lo que cobrará ',salario*horas,' $';
	
FinAlgoritmo
