Algoritmo ejercicio8
	definir mes Como Caracter;
	definir precio como real;
	escribir Sin Saltar 'Ingresar el mes en curso ';
	leer mes;
	Escribir Sin Saltar'Ingresar el precio de lista ';
	Leer  precio;
	si mes='octubre' Entonces
		precio = precio*.85;
	FinSi
	
	escribir 'el  precio que se deberá cobrar es de $ ',precio;
FinAlgoritmo
