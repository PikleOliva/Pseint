Proceso Operaciones
	definir num1, num2, resul Como Real;
	num1 <-0;
	num2 <-0;
	resul <-0;
	Escribir 'Ingresar el primer número: '; 
	Leer  num1;
	Escribir 'Ingresar el segundo número: '; 
	Leer  num2;
	resul<-num1+num2;
	Escribir 'La suma de ',num1, ' más ',num2,' es: ',resul;
	resul<-num1-num2;
	Escribir 'La resta de ',num1,' menos ',num2,' es: ',resul;
	resul<-num1*num2;
	Escribir 'La multiplicación de ',num1,' por ',num2,' es: ',resul;
	resul<-num1/num2;
	Escribir 'La división de ',num1, ' dividido ',num2, ' es: ',resul;
				
	
FinProceso
