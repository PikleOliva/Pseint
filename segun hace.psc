Algoritmo entregarMedallas
	definir clasif Como entero
	escribir Sin Saltar 'Usted llegó en la posición ', clasif
	leer clasif
	segun clasif hacer
		1: escribir 'Ganó medalla de oro'
		2: escribir 'Ganó medalla de plata'
		3: escribir 'Ganó medalla de bronce'
		De Otro Modo:
		Escribir 'Usted llegó en posición ',clasif,'. Le otorgamos certificado de participación'
			
	FinSegun
	
FinAlgoritmo
