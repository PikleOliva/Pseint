Algoritmo ejercicio7
	definir varon, mujer, total Como Entero;
	Escribir Sin Saltar'Ingrese el número de varones';
	leer varon;
	Escribir Sin Saltar'Ingrese el número de mujeres';
	leer mujer;
	total=varon+mujer;
	escribir 'En total hay ',total,' alumnos, de los cuales el ',trunc(varon*100/total),'% son varones, y el ',trunc(mujer*100/total),'% son mujeres';
	
	
FinAlgoritmo
