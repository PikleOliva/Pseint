Algoritmo perimetroTriangulo
	definir lado1,lado2,lado3, per como real;
	escribir 'ingresar el primer lado';
	leer lado1;
	escribir 'ingresar el segundo lado';
	leer lado2;
	escribir 'ingresar el tercer lado';
	leer lado3;
	per= lado1+lado2+lado3;
	Escribir 'El perímetro del triángulo es :',per;
	
	
FinAlgoritmo
